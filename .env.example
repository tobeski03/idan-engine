# ── Device-level overrides (optional) ────────────────────────────────────────
# These have built-in defaults and only need to be set if you want to change them.

# Port the engine listens on (default: 3788)
# IDAN_ENGINE_PORT=3788

# Network interface to bind to (default: 0.0.0.0)
# IDAN_ENGINE_HOST=0.0.0.0

# Cost-conscious AI context limits. Lower values reduce token usage on long chats.
# IDAN_AI_CONTEXT_MESSAGES=8
# IDAN_AI_MEMORY_ITEMS=12
# GEMINI_MODEL=gemini-2.5-flash-lite

# WhatsApp uses whatsmeow when a sidecar binary is present in engine/bin.
# IDAN_WHATSAPP_PROVIDER=whatsmeow
# IDAN_WHATSAPP_BINARY=/data/data/com.termux/files/home/idanMobile-lite/engine/bin/idan-whatsapp-sidecar-android-arm64

# Optional Chrome DevTools endpoint for real browser control.
# IDAN_CHROME_CDP_URL=http://127.0.0.1:9222
